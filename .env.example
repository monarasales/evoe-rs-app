# Copie este arquivo para ".env" (sem o ".example") e preencha com seus dados reais.
# O arquivo .env nunca deve ser compartilhado nem enviado para ninguém — ele fica só no seu computador.

# E-mail que vai enviar os contratos (Gmail). Veja no README como gerar a "senha de app".
EMAIL_USER=seuemail@gmail.com
EMAIL_PASS=senha-de-app-de-16-letras

# Porta em que o sistema roda localmente (normalmente não precisa mudar).
PORT=3000

# Chave da API da Anthropic (console.anthropic.com) — usada só pela leitura automática
# de arquivo de vaga com IA (em Funil de Vagas > Nova Vaga). Sem essa chave, essa
# função específica fica indisponível (com um aviso claro), mas o resto do sistema
# funciona normalmente. Veja no README como criar a chave.
ANTHROPIC_API_KEY=

# Opcional: só preencha se precisar trocar o modelo de IA usado na leitura de arquivo
# (ex: se a Anthropic descontinuar o modelo padrão no futuro). Deixe em branco pra
# usar o padrão do sistema.
ANTHROPIC_MODEL=
